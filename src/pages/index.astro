---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Arco Glass | Soluciones en vidrio';
const description =
  'Diseño, fabricación e instalación de vidrio premium para proyectos residenciales y corporativos.';
---

<BaseLayout title={title} description={description}>
  <header>
    <div class="nav">
      <div class="brand">
        <span>AG</span>
        Arco Glass
      </div>
      <nav class="nav-links">
        <a href="#productos">Productos</a>
        <a href="#servicios">Servicios</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="cta-nav" href="#contacto">Cotizar ahora</a>
    </div>
  </header>

  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Soluciones en vidrio arquitectónico</p>
      <h1>Diseñamos, fabricamos e instalamos vidrio premium para espacios modernos.</h1>
      <p>
        En Arco Glass combinamos tecnología, diseño y servicio experto para entregar fachadas, interiores y proyectos
        personalizados con la máxima transparencia y seguridad.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#contacto">Agenda una asesoría</a>
        <a class="button secondary" href="#productos">Ver catálogo</a>
      </div>
    </div>
    <div class="hero-card">
      <h3>¿Por qué elegir Arco Glass?</h3>
      <ul class="hero-list">
        <li><span>01</span>Manufactura certificada y control de calidad en cada lote.</li>
        <li><span>02</span>Asesoría técnica desde el concepto hasta la instalación.</li>
        <li><span>03</span>Tiempo de entrega ágil con logística propia.</li>
      </ul>
    </div>
  </section>

  <section class="section" id="productos">
    <div class="section-title">
      <div>
        <h2>Productos pensados para cada proyecto</h2>
        <p>
          Catálogo actualizado de soluciones en vidrio, con opciones de seguridad, eficiencia energética y diseño a la
          medida.
        </p>
      </div>
    </div>
    <div class="grid">
      <article class="card">
        <div class="icon">TG</div>
        <h3>Vidrio templado</h3>
        <p>Resistente al impacto y a cambios térmicos. Ideal para puertas, barandales y fachadas ligeras.</p>
      </article>
      <article class="card">
        <div class="icon">LG</div>
        <h3>Vidrio laminado</h3>
        <p>Mayor seguridad y control acústico. Perfecto para áreas de alto tráfico y proyectos premium.</p>
      </article>
      <article class="card">
        <div class="icon">IG</div>
        <h3>Unidad insulada</h3>
        <p>Reduce el intercambio térmico y mejora la eficiencia energética en ventanas y muros cortina.</p>
      </article>
      <article class="card">
        <div class="icon">DG</div>
        <h3>Vidrio decorativo</h3>
        <p>Texturas y acabados personalizados para interiores elegantes, corporativos o residenciales.</p>
      </article>
    </div>
    <div class="stats">
      <div class="stat">
        <strong>+18</strong>
        <p>años de experiencia</p>
      </div>
      <div class="stat">
        <strong>+320</strong>
        <p>proyectos entregados</p>
      </div>
      <div class="stat">
        <strong>48h</strong>
        <p>promedio de respuesta</p>
      </div>
      <div class="stat">
        <strong>99%</strong>
        <p>satisfacción de clientes</p>
      </div>
    </div>
  </section>

  <section class="section" id="servicios">
    <div class="highlight">
      <div>
        <h2>Servicios integrales de principio a fin</h2>
        <p>
          Nuestro equipo técnico acompaña cada fase del proyecto para asegurar resultados precisos, sostenibles y con
          estética impecable.
        </p>
        <ul>
          <li>Levantamiento, medición y planeación en sitio.</li>
          <li>Fabricación personalizada con control digital.</li>
          <li>Instalación profesional y mantenimiento preventivo.</li>
        </ul>
      </div>
      <div class="grid">
        <article class="card">
          <div class="icon">01</div>
          <h3>Consultoría</h3>
          <p>Diagnóstico de proyecto, normativas y recomendaciones de diseño.</p>
        </article>
        <article class="card">
          <div class="icon">02</div>
          <h3>Ingeniería</h3>
          <p>Diseño estructural y cálculos para soluciones seguras y eficientes.</p>
        </article>
        <article class="card">
          <div class="icon">03</div>
          <h3>Instalación</h3>
          <p>Equipos especializados que garantizan acabados limpios y durables.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="proyectos">
    <div class="section-title">
      <div>
        <h2>Proyectos que reflejan nuestro estándar</h2>
        <p>Trabajamos con desarrolladores, arquitectos y marcas que buscan un acabado impecable.</p>
      </div>
      <a class="button secondary" href="#contacto">Solicitar portafolio</a>
    </div>
    <div class="grid">
      <article class="card">
        <h3>Oficinas corporativas</h3>
        <p>Muros cortina y particiones acústicas con integración de herrajes premium.</p>
      </article>
      <article class="card">
        <h3>Residenciales de lujo</h3>
        <p>Barandales, fachadas y domos con vidrio templado de alta claridad.</p>
      </article>
      <article class="card">
        <h3>Retail &amp; hospitality</h3>
        <p>Escaparates de alto impacto visual y puertas automáticas para flujos intensos.</p>
      </article>
    </div>
  </section>

  <section class="section" id="contacto">
    <div class="section-title">
      <div>
        <h2>Hablemos de tu próximo proyecto</h2>
        <p>Comparte tu idea y nuestro equipo responderá en menos de 48 horas.</p>
      </div>
    </div>
    <div class="grid">
      <article class="card">
        <h3>Contacto directo</h3>
        <p>Correo: hola@arcoglass.com</p>
        <p>Teléfono: +52 (55) 5555 1234</p>
      </article>
      <article class="card">
        <h3>Showroom</h3>
        <p>Av. Arquitectos 230, Col. Centro, CDMX</p>
        <p>Lunes a Viernes · 9:00 - 18:00</p>
      </article>
      <article class="card">
        <h3>Seguimiento</h3>
        <p>Agenda una visita técnica o recibe nuestro catálogo digital actualizado.</p>
        <a class="button primary" href="mailto:hola@arcoglass.com">Enviar mensaje</a>
      </article>
    </div>
  </section>

  <footer>
    <div class="footer-grid">
      <div>
        <h4>Arco Glass</h4>
        <p>Soluciones en vidrio arquitectónico para proyectos residenciales, comerciales y corporativos.</p>
      </div>
      <div>
        <h4>Servicios</h4>
        <p>Fabricación · Instalación · Mantenimiento</p>
      </div>
      <div>
        <h4>Contacto</h4>
        <p>hola@arcoglass.com</p>
        <p>+52 (55) 5555 1234</p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2025 Arco Glass. Todos los derechos reservados.</span>
      <span>Diseñado para espacios con claridad.</span>
    </div>
  </footer>
</BaseLayout>

<style>
  .eyebrow {
    color: var(--primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.6px;
  }
</style>
